@Library('CoreLogicDevopsUtils')
@Library('CoreLogicPipelineUtils')
@Library('CoreLogicOrgPipelineConfig')

import com.corelogic.devops.utils.PodTemplates

slaveTemplates = new PodTemplates()
def containerName = "python-uv"
def label = "idap-agents-glb-ag_foundation-${containerName}-" + UUID.randomUUID().toString()
def dImage = "us-docker.pkg.dev/clgx-artregistry-mgt-prd-3b27/idap-analytics-glb-genaifoundationglb-docker-local/${containerName}"

def flowName = 'featureFlow'
def branchName = env.BRANCH_NAME
if (branchName == "develop") {
    flowName = 'developFlow'
} else if (branchName == "master") {
    flowName = 'masterFlow'
}


slaveTemplates.getPodTemplate(label, containerName, dImage) {
 node(label){
      container(containerName) {

	    def pipeline = pipelineManager.config()

        def buildType = new com.corelogic.pipeline.DeployableType(
            appName: 'adk-template-base',
            ecosystemName: 'ag_foundation',
            cloudNative: true,
            buildDockerImage: false,
            publishToArtifactRegistory: true,
            enableVeracodeForLibs: false,
            pipelineFlowName: flowName,
            fieldValueMap : [
                "Integration Tests": { runIntegrationTests() },
                "Unit Tests": { runUnitTests() }
            ],
            builder: new com.corelogic.builder.UvBuilder(
                    preBuildStage: [
                        'Replace Pyproject Placeholders': {
                            replacePyprojectPlaceholders()
                        },
                        'Format Check': {
                            sh 'uv run --extra lint ruff format . --check'
                        },
                        'Lint Check': {
                            sh 'uv run --extra lint ruff check .'
                        }
                    ]
            ),
        )
        pipeline.execute(buildType)
        }
    }
}

def runUnitTests() {
    try {
        echo 'Running unit tests...'
        sh 'uv sync --all-packages --extra dev'
        sh 'uv run nox -s tests'
    } catch (e) {
        echo 'Unit Test Failures: ' + e.toString()
        throw e
    }
}

def runIntegrationTests() {
    try {
        echo 'Running integration tests...'
        sh 'uv sync --all-packages --extra dev'
        sh 'uv run nox -s integrations'
    } catch (e) {
        echo 'Integration Test Failures: ' + e.toString()
        throw e
    }
}

def replacePyprojectPlaceholders() {
    try {
        echo 'Replacing placeholders in pyproject.toml...'

        // Define the replacement values
        def appName = 'adk-template-base'  // You can make this dynamic if needed
        def description = 'ADK Template Base Application'  // You can make this dynamic if needed

        // Read the current pyproject.toml
        def pyprojectContent = readFile('pyproject.toml')

        // Replace the placeholders
        pyprojectContent = pyprojectContent.replace('${{GLOBAL:APPLICATION_NAME_HYPHEN}}', appName)
        pyprojectContent = pyprojectContent.replace('${{DESCRIPTION}}', description)

        // Write the updated content back to the file
        writeFile file: 'pyproject.toml', text: pyprojectContent

        echo 'Successfully replaced placeholders in pyproject.toml'
    } catch (e) {
        echo 'Error replacing placeholders: ' + e.toString()
        throw e
    }
}